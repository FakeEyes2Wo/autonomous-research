{
  "name": "@athena/autoresearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./settings": "./dist/settings/index.js",
    "./settings-contract": "./dist/settings-contract.js",
    "./policy": "./dist/policy/index.js",
    "./runtime": "./dist/runtime/index.js",
    "./literature": "./dist/literature/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "templates",
    "presets",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --experimental-strip-types scripts/test.mjs",
    "check:dsh": "node scripts/check-dsh-runtime.mjs",
    "install:dsh": "node scripts/install-dsh-plugin.mjs",
    "run:headless": "npm run build && node scripts/run-headless.mjs",
    "runtime:job": "node scripts/runtime-job.mjs",
    "literature": "node scripts/literature.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-subagent": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.1.5-alpha.1"
  },
  "license": "MIT",
  "dependencies": {
    "cytoscape": "^3.34.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-metrics": "^2.4.0",
    "graphology-types": "^0.24.8",
    "parse5": "8.0.0",
    "pdfjs-dist": "6.3.289",
    "yaml": "^2.9.0"
  }
}
